{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-agent-containment:schema:resource:0.1.0",
  "title": "Synthetic Resource Contract",
  "$comment": "Traceable to Implementation Contract v0.1 Resource Contract requirements and the Threat & Scenario Specification synthetic asset model.",
  "type": "object",
  "properties": {
    "resource_id": {
      "$ref": "urn:frontier-agent-containment:schema:common:0.1.0#/$defs/resource_id"
    },
    "resource_version": {
      "$ref": "urn:frontier-agent-containment:schema:common:0.1.0#/$defs/executable_artifact_version"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "trust_zone": {
      "type": "string",
      "enum": ["Z1", "Z2", "Z3", "Z4", "Z5", "Z6"]
    },
    "authority_model": {
      "type": "string",
      "minLength": 1
    },
    "protected": {
      "type": "boolean"
    },
    "legitimate_interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action_class"
      },
      "uniqueItems": true
    },
    "security_relevant_state": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state_property"
      },
      "uniqueItems": true
    },
    "participates_in_scored_scenarios": {
      "type": "boolean"
    }
  },
  "required": [
    "resource_id",
    "resource_version",
    "display_name",
    "description",
    "trust_zone",
    "authority_model",
    "protected",
    "legitimate_interactions",
    "security_relevant_state",
    "participates_in_scored_scenarios"
  ],
  "additionalProperties": false,
  "$defs": {
    "action_class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "state_property": {
      "type": "object",
      "properties": {
        "state_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["state_name", "description"],
      "additionalProperties": false
    }
  }
}
